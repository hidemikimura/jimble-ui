{
  "name": "@hidemikimura/jimble-ui",
  "version": "0.6.1",
  "description": "管理画面向け UI コンポーネントライブラリ（Lit 3 + Tailwind CSS v4）",
  "license": "MIT",
  "author": "hidemikimura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidemikimura/jimble-ui.git"
  },
  "homepage": "https://github.com/hidemikimura/jimble-ui",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.ts",
    "gen:tokens:check": "node scripts/gen-tokens.ts --check",
    "gen:icons": "node scripts/gen-icons.ts",
    "gen:icons:check": "node scripts/gen-icons.ts --check",
    "gen:manifest": "cem analyze --config custom-elements-manifest.config.mjs",
    "gen:skill": "node scripts/gen-skill.ts",
    "gen:skill:check": "node scripts/gen-skill.ts --check",
    "prebuild": "npm run gen:tokens && npm run gen:icons && npm run gen:manifest && npm run gen:skill",
    "build": "vite build && vite build --config vite.cdn.config.ts && tsc -p tsconfig.build.json && node scripts/postbuild.ts",
    "check-dist": "node scripts/check-dist.ts",
    "check-package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css ./cloak.css",
    "pack-smoke": "node scripts/pack-smoke.ts",
    "theme-lab": "npm --prefix theme-lab run dev",
    "theme-lab:build": "npm --prefix theme-lab run build",
    "dev:site": "npm run gen:manifest && vite --config site/vite.config.ts",
    "build:site": "npm run gen:manifest && vite build --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run gen:tokens && npm run gen:icons && npm run gen:manifest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run check-dist && npm run check-package"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@vitest/browser-playwright": "^5.0.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "heroicons": "^2.2.0",
    "lefthook": "^2.1.14",
    "lightningcss": "^1.33.0",
    "markdown-it": "^15.0.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*.js",
    "./dist/icons/*.js",
    "./dist/chunks/*.js",
    "./dist/cdn/*.js",
    "./src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/types/icons/register/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./icons/names": {
      "types": "./dist/types/icons/names.d.ts",
      "default": "./dist/icons/names.js"
    },
    "./icons/*": {
      "types": "./dist/types/icons/register/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n/index.d.ts",
      "default": "./dist/i18n.js"
    },
    "./locales/*": {
      "types": "./dist/types/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./cloak.css": "./dist/cloak.css",
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-data.json": "./dist/vscode.html-data.json",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/types/components/*/index.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "skills",
    "custom-elements.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES",
    "CHANGELOG.md"
  ],
  "keywords": [
    "web-components",
    "lit",
    "tailwindcss",
    "ui",
    "admin"
  ],
  "customElements": "custom-elements.json",
  "bugs": {
    "url": "https://github.com/hidemikimura/jimble-ui/issues"
  }
}
